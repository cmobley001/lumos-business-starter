---
import Icon from "@/components/media/Icon.astro";
import logo from "@/assets/logo/logo.svg";
import { SITE_NAME } from "@/consts.ts";
import { BUSINESS, SOCIALS, NAV_ITEMS } from "@/data/business.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const { phone, email, address, hours, tagline } = BUSINESS;
const phoneHref = `tel:${phone.replace(/[^\d+]/g, "")}`;
---

{render && (
  <footer class="footer_wrap">
    <div class="footer_inner">
      <div class="footer_top">
        <a class="footer_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        <p class="footer_tagline text-style-small">{tagline}</p>
      </div>
      <div class="footer_columns">
        <nav aria-label="Footer">
          <ul class="footer_links">
            {NAV_ITEMS.map((item) => (
              <li>
                <a class="footer_link" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <address class="footer_contact text-style-small">
          <a class="footer_link" href={phoneHref}>{phone}</a>
          <a class="footer_link" href={`mailto:${email}`}>{email}</a>
          <span>
            {address.street}, {address.city}, {address.region}
            {address.postalCode}
          </span>
        </address>
        <ul class="footer_hours text-style-small">
          {hours.map((row) => (
            <li>
              <span>{row.days}</span> <span>{row.time}</span>
            </li>
          ))}
        </ul>
        {SOCIALS.length > 0 && (
          <ul class="footer_socials">
            {SOCIALS.map((social) => (
              <li>
                <a
                  class="footer_link"
                  href={social.href}
                  rel="noopener noreferrer"
                  aria-label={social.platform}
                >
                  {social.platform}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
      <div class="footer_bottom">
        <p class="footer_copyright text-style-small">
          &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
          {SITE_NAME}
        </p>
      </div>
    </div>
  </footer>
)}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-small);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4) var(--space-6);
    }

    .footer_logo {
      display: block;
      width: 7.5rem;
      max-width: 100%;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_tagline {
      color: var(--text-2);
      max-width: 40ch;
    }

    .footer_columns {
      display: grid;
      gap: var(--space-6);
      @media (width >= 48rem) {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .footer_links,
    .footer_socials,
    .footer_hours,
    .footer_contact {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      font-style: normal;
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_hours,
    .footer_contact {
      color: var(--text-2);
    }

    .footer_link {
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_bottom {
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-2);
    }
  }
</style>
